---
interface Props {
  name: string;
  class?: string;
}
const { name, class: klass = 'w-8 h-8' } = Astro.props;
---

{name === 'Front Suspension' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <path d="M9 4v4" stroke-linecap="round" />
    <path d="M9 8l4 2-4 2 4 2-4 2 4 2-4 2v4" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="23" cy="9" r="3" />
    <path d="M23 12v6" stroke-linecap="round" />
    <path d="M17 26h12M19 26l2-4M27 26l-2-4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'Brakes' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <circle cx="16" cy="16" r="11" />
    <circle cx="16" cy="16" r="4" />
    <path d="M16 5v4M16 23v4M5 16h4M23 16h4M8.5 8.5l2.8 2.8M20.7 20.7l2.8 2.8M8.5 23.5l2.8-2.8M20.7 11.3l2.8-2.8" stroke-linecap="round" />
  </svg>
)}
{name === 'Electrical' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <rect x="7" y="6" width="18" height="20" rx="2" />
    <path d="M18 11l-6 8h5l-2 6 7-9h-5l1-5z" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'Engine' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <rect x="5" y="12" width="14" height="10" rx="1" />
    <path d="M9 12V9h6v3M13 8V6" stroke-linecap="round" />
    <circle cx="23" cy="17" r="5" />
    <path d="M23 12v2M23 20v2M18 17h2M26 17h2" stroke-linecap="round" />
  </svg>
)}
{name === 'Cooling System' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <rect x="5" y="6" width="12" height="20" rx="1" />
    <path d="M8 6v20M11 6v20M14 6v20" />
    <circle cx="23" cy="16" r="7" />
    <path d="M23 16c0-3 2-4 2-4s1 2-1 4c2 0 4 1 4 1s-2 1-4 1c2 2 1 4 1 4s-2-1-2-4c0 3-2 4-2 4s-1-2 1-4c-2 0-4-1-4-1s2-1 4-1c-2-2-1-4-1-4s2 1 2 4z" stroke-linejoin="round" />
  </svg>
)}
{name === 'Steering' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <circle cx="16" cy="16" r="10" />
    <circle cx="16" cy="16" r="2" />
    <path d="M16 6v6M16 26v-4M7.5 21l5-3M24.5 21l-5-3" stroke-linecap="round" />
  </svg>
)}
{name === 'Parts Reference' && (
  <svg viewBox="0 0 32 32" fill="none" class={klass} stroke="currentColor" stroke-width="1.5">
    <path d="M22 5a4 4 0 00-5.6 5.6L7 20v3h3l9.4-9.4A4 4 0 0025 9l-3.5 3.5-2-2L23 6.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
