---
interface Step {
  id: string;
  label: string;
  required: boolean;
  note?: string;
}
interface Props {
  slug: string;
  steps: Step[];
}
const { slug, steps } = Astro.props;
const required = steps.filter((s) => s.required);
---

{steps.length > 0 && (
  <div class="mb-8 rounded-xl border border-amber-900/50 bg-amber-950/10 p-4 sm:p-5" data-step-hero>
    <div class="flex items-center justify-between gap-4 mb-3">
      <p class="text-sm font-semibold text-amber-400">Your progress on this job</p>
      <p data-step-count class="text-xs text-stone-400 shrink-0">0 / {required.length} must-do steps</p>
    </div>
    <div class="h-2 rounded-full bg-stone-800 overflow-hidden mb-3">
      <div data-step-bar class="h-full bg-amber-500 transition-all duration-500 ease-out" style="width: 0%"></div>
    </div>
    <p class="text-sm text-stone-300">
      <span class="text-stone-500">Next up:</span> <span data-step-next>{required[0]?.label ?? 'All done'}</span>
    </p>
  </div>

  <script define:vars={{ slug, steps }}>
    const KEY = `delica:steps:${slug}`;
    const required = steps.filter((s) => s.required);

    function loadDone() {
      try {
        return new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));
      } catch {
        return new Set();
      }
    }

    function render() {
      const done = loadDone();
      const doneRequired = required.filter((s) => done.has(s.id));
      const pct = required.length ? Math.round((doneRequired.length / required.length) * 100) : 0;
      const next = required.find((s) => !done.has(s.id));

      document.querySelectorAll('[data-step-count]').forEach((el) => {
        el.textContent = `${doneRequired.length} / ${required.length} must-do steps`;
      });
      document.querySelectorAll('[data-step-bar]').forEach((el) => {
        el.style.width = `${pct}%`;
      });
      document.querySelectorAll('[data-step-next]').forEach((el) => {
        el.textContent = next ? next.label : 'All must-do steps complete';
      });
    }

    render();
    window.addEventListener('steps-updated', (e) => {
      if (e.detail?.slug === slug) render();
    });
  </script>
)}
