---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ToolsList from '../../components/ToolsList.astro';
import StepHero from '../../components/StepHero.astro';
import StepFooter from '../../components/StepFooter.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const { title, description, manualGroup, manualPages, applicability, tools, lastUpdated, totalTime, steps = [] } = guide.data;

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description,
  dateModified: lastUpdated,
  ...(totalTime ? { totalTime } : {}),
  tool: tools.map((t) => ({ '@type': 'HowToTool', name: t })),
  about: {
    '@type': 'Vehicle',
    vehicleModelDate: '1986-1994',
    manufacturer: 'Mitsubishi',
    model: 'Delica Star Wagon / L300',
  },
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <nav class="text-sm text-stone-500 mb-6">
    <a href="/" class="hover:text-amber-400">Guides</a> / <span class="text-stone-300">{title}</span>
  </nav>

  <div class={`flex gap-10 items-start ${steps.length > 0 ? 'pb-20' : ''}`}>
    <article class="min-w-0 flex-1">
      <h1 class="text-3xl font-bold text-stone-50 mb-2">{title}</h1>
      <p class="text-stone-400 mb-6">{description}</p>

      <StepHero slug={guide.id} steps={steps} />

      <dl class="grid sm:grid-cols-3 gap-4 mb-8 rounded-lg border border-stone-800 bg-stone-900/50 p-4 text-sm">
        <div>
          <dt class="text-stone-500 uppercase text-xs tracking-wide">Manual section</dt>
          <dd class="text-stone-200">{manualGroup}</dd>
        </div>
        <div>
          <dt class="text-stone-500 uppercase text-xs tracking-wide">Manual pages</dt>
          <dd class="text-stone-200">{manualPages}</dd>
        </div>
        <div>
          <dt class="text-stone-500 uppercase text-xs tracking-wide">Applies to</dt>
          <dd class="text-stone-200">{applicability}</dd>
        </div>
      </dl>

      <ToolsList tools={tools} />

      <div class="prose prose-invert prose-headings:text-amber-400 prose-a:text-amber-400 prose-table:text-sm max-w-none
                  prose-h2:mt-10 prose-h2:mb-3 prose-h3:mt-6 prose-table:border prose-table:border-stone-800
                  prose-th:border prose-th:border-stone-800 prose-th:bg-stone-900 prose-td:border prose-td:border-stone-800
                  prose-headings:scroll-mt-8 prose-img:rounded-lg prose-img:border prose-img:border-stone-800 prose-img:mt-3 prose-img:mb-2
                  [&_p:has(>img)]:mb-6 [&_p:has(>img)_em]:block [&_p:has(>img)_em]:text-xs [&_p:has(>img)_em]:text-stone-500 [&_p:has(>img)_em]:mt-2">
        <Content />
      </div>

      <p class="text-xs text-stone-600 mt-10">Last updated {lastUpdated}.</p>
    </article>

    <TableOfContents headings={headings} steps={steps} slug={guide.id} />
  </div>

  <StepFooter slug={guide.id} steps={steps} />
</Layout>
